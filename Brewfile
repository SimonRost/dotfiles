# Homebrew Bundle manifest for this workstation.
#
# Prerequisites:
# - Homebrew must be installed.
# - Git is needed initially to clone this repository.
#
# Install or reconcile declared packages:
#   brew bundle --file="$HOME/dotfiles/Brewfile"
#
# This file intentionally contains only the portable terminal baseline.
# Docker Desktop, OrbStack, IDEs, and other larger applications are managed
# separately until their intended role is decided.

# Core development tools.
brew "git"
brew "neovim"

# Interactive terminal tools used by the shell configuration.
brew "eza"
brew "fzf"
brew "zoxide"
brew "tmux"

# Terminal emulator.
cask "kitty"
